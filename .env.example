# Bu dosyayı `.env` olarak kopyalayıp doldurun: cp .env.example .env
# .env git'e commit EDİLMEZ (.gitignore'da).

# ─── SMTP (NotificationService / NotificationInboxWorker) ───────────
# Gmail kullanıyorsanız normal parola değil "App Password" gerekir:
# https://myaccount.google.com/apppasswords
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Postgres ───────────────────────────────────────────────────────
POSTGRES_USER=ahmet
POSTGRES_PASSWORD=Ahmet.123

# ─── Keycloak admin ─────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── MinIO (medya deposu) ───────────────────────────────────────────
# Üretimde AWS S3'e geçerken kod değişmez, yalnızca news-service'in
# Storage__Endpoint / Storage__PublicEndpoint / anahtar değerleri değişir.
MINIO_ROOT_USER=telgraf
MINIO_ROOT_PASSWORD=Telgraf.123
MINIO_BUCKET=telgraf-media

# ─── Servisler arası dahili çağrı (IdentityService ↔ NotificationInboxWorker) ─
# notification-inbox-worker, yayınlanan haberin yazarının gerçek e-postasını
# çözmek için IdentityService'in /api/user/internal/contact uç noktasını bu
# anahtarla çağırır. Rastgele üretin: openssl rand -hex 32
INTERNAL_API_KEY=

# ─── Sağlık bildirimleri ────────────────────────────────────────────
# Bir process Unhealthy'ye düştüğünde buraya bildirim gider (Slack/Discord
# webhook adresi). BOŞ BIRAKILABİLİR: o zaman bildirim kurulmaz ve panel
# yalnızca görsel uyarı verir.
HEALTH_WEBHOOK_URL=

# ─── Elasticsearch / Kibana ─────────────────────────────────────────
# Kimlik doğrulama AÇIK. Kapalıyken kümeye ağdaki herkes yazabiliyordu; ayrıca
# Kibana Fleet'i güvenlik kapalıyken çalışmıyor ve APM entegrasyonu ancak
# Fleet üzerinden kuruluyor.
#
# Hesaplar ayrı, hepsi tek parolayı paylaşmıyor:
#   elastic       — yönetici; kurulum betiği ve APM Server kullanıyor
#   kibana_system — Kibana'nın kendi bağlantısı
#   logstash_writer — yalnızca logs-* üzerine yazabilir
#   log_reader    — salt okunur; Grafana panosu ve hata oranı kontrolü
#
# Parolaları rastgele üretin:  openssl rand -base64 24
ELASTIC_PASSWORD=
KIBANA_PASSWORD=
LOGSTASH_PASSWORD=
LOG_READER_PASSWORD=

# Fleet, entegrasyon ayarlarını bu anahtarla şifreliyor. En az 32 karakter
# olmalı ve SABİT kalmalı — değişirse mevcut şifreli kayıtlar okunamaz hale
# gelir.  openssl rand -hex 16
KIBANA_ENCRYPTION_KEY=

# NOT: Kümeyi ilk kez ayağa kaldırdıktan sonra hesapları ve APM entegrasyonunu
# kuran betiği çalıştırın:
#
#   docker compose up -d elasticsearch kibana
#   ./docker/setup-elastic-security.sh
#   docker compose up -d
#
# Betik tekrar çalıştırılabilir; kurulum bozulursa yeniden çalıştırmak güvenli.
