# Bu dosyayı `.env` olarak kopyalayıp doldurun: cp .env.example .env
# .env git'e commit EDİLMEZ (.gitignore'da).

# ─── SMTP (NotificationService / NotificationInboxWorker) ───────────
# Gmail kullanıyorsanız normal parola değil "App Password" gerekir:
# https://myaccount.google.com/apppasswords
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Postgres ───────────────────────────────────────────────────────
POSTGRES_USER=ahmet
POSTGRES_PASSWORD=Ahmet.123

# ─── Keycloak admin ─────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── MinIO (medya deposu) ───────────────────────────────────────────
# Üretimde AWS S3'e geçerken kod değişmez, yalnızca news-service'in
# Storage__Endpoint / Storage__PublicEndpoint / anahtar değerleri değişir.
MINIO_ROOT_USER=telgraf
MINIO_ROOT_PASSWORD=Telgraf.123
MINIO_BUCKET=telgraf-media

# ─── Servisler arası dahili çağrı (IdentityService ↔ NotificationInboxWorker) ─
# notification-inbox-worker, yayınlanan haberin yazarının gerçek e-postasını
# çözmek için IdentityService'in /api/user/internal/contact uç noktasını bu
# anahtarla çağırır. Rastgele üretin: openssl rand -hex 32
INTERNAL_API_KEY=
