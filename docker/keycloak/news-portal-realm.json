{
  "realm": "news-portal",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 3600,

  "_comment_bruteForce": "Giriş APISIX'ten geçmediği için brute-force koruması burada yapılır. IP değil hesap bazlı çalışır: saldırgan IP değiştirse de korumaya devam eder. permanentLockout=false — kilit kalıcı değil, süre dolunca kendiliğinden açılır.",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Tam yetki: kullanıcı yönetimi, kategori/etiket CRUD, makale yayınlama"
      },
      {
        "name": "editor",
        "description": "Makale oluşturma, güncelleme ve silme"
      },
      {
        "name": "user",
        "description": "Varsayılan rol: yayınlanmış içerikleri okuma"
      }
    ]
  },
  "clients": [
    {
      "clientId": "news-portal-client",
      "name": "News Portal Client",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "fullScopeAllowed": true
    }
  ]
}
