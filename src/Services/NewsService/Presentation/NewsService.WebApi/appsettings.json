{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "Kafka": {
      "Topic": "logs",
      "BatchSize": 500,
      "FlushSeconds": 2,
      "QueueLimit": 10000
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=NewsServiceDb;Username=ahmet;Password=Ahmet.123"
  },
  "Keycloak": {
    "Authority": "https://keycloak.yourdomain.com/realms/news-portal",
    "Audience": "news-service",
    "RequireHttpsMetadata": true
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092"
  },
  "Storage": {
    "Endpoint": "http://minio:9000",
    "PublicEndpoint": "http://localhost:9000",
    "Bucket": "telgraf-media",
    "AccessKey": "",
    "SecretKey": "",
    "UploadUrlTtlSeconds": 300
  },
  "Redis": {
    "Connection": "redis:6379",
    "CircuitOpenSeconds": 10
  },
  "Weather": {
    "City": "Ankara",
    "Latitude": 39.9334,
    "Longitude": 32.8597,
    "Timezone": "Europe/Istanbul",
    "BaseUrl": "https://api.open-meteo.com/v1/forecast",
    "TimeoutSeconds": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System.Net.Http.HttpClient": "Warning",
        "LuckyPennySoftware.MediatR.License": "Error",
        "Microsoft.AspNetCore.DataProtection": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
