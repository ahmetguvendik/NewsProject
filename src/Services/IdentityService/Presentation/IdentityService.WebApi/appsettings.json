{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "Kafka": {
      "Topic": "logs",
      "BatchSize": 500,
      "FlushSeconds": 2,
      "QueueLimit": 10000
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=NewsIdentityServiceDb;Username=ahmet;Password=Ahmet.123"
  },
  "Keycloak": {
    "Authority": "https://keycloak.yourdomain.com/realms/news-portal",
    "Audience": "identity-service",
    "RequireHttpsMetadata": true
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092"
  },
  "Internal": {
    "ApiKey": ""
  },
  "Redis": {
    "Connection": "redis:6379",
    "CircuitOpenSeconds": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
