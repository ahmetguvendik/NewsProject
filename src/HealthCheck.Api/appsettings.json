{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HealthChecksUI": {
    "EvaluationSeconds": 15,
    "HealthChecks": [
      { "Name": "News Service", "Uri": "http://news-service:8080/health" },
      { "Name": "Identity Service", "Uri": "http://identity-service:8080/health" },
      { "Name": "Notification Service", "Uri": "http://notification-service:8080/health" }
    ]
  }
}
